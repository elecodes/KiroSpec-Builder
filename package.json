{
  "name": "kirospec-builder",
  "version": "0.1.0",
  "description": "AI Agent that converts unstructured input into native Kiro Specification files (.kiro/specs/)",
  "type": "module",
  "main": "dist/infrastructure/cli/index.js",
  "bin": {
    "kirospec": "dist/infrastructure/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/infrastructure/cli/index.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint src/ tests/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ tests/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "kiro",
    "spec",
    "ai-agent",
    "ears-syntax",
    "clean-architecture",
    "mcp",
    "llm"
  ],
  "author": "Elena Menendez",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "pino": "^9.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  }
}
